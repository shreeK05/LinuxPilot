[Unit]
Description=LinuxPilot FastAPI Backend Service
After=network.target postgresql.service

[Service]
User=sahil
Group=www-data
WorkingDirectory=/home/sahil/LinuxPilot/apps/api
EnvironmentFile=/home/sahil/LinuxPilot/.env
ExecStart=/home/sahil/LinuxPilot/apps/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
